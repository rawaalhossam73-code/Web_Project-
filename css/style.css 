body {
    margin: 0;
    padding: 20px;
    box-sizing: border-box;
    background: #f4f6f9;
  
}

/* تنسيق خاص لعربة التسوق فقط */
.cart {
    padding: 5px 15px;
    background: #ffffff;
    margin-bottom: 20px;
    width: fit-content; 
    margin-left: auto;  
    border-radius: 0 0 0 15px; 
}


.cart-icon {
    font-weight: bold;
    font-size: 18px;
}
.section-title{
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 30px;
    margin-bottom: 5px;
}

.title-shape{
    width: 15px;
    height: 25px;
    background-color: #0077ff;
    border-radius: 4px;
}
.cards {
    display: flex;
    gap: 15px;
    flex-wrap: nowrap;
    overflow-x: auto;
    padding-bottom: 20px;
    scrollbar-width: none;
}
.card {
    background: white;
    padding: 15px;
    border-radius: 16px;
    text-align: center;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    min-width: 160px;
    width: 160px;
    height: 320px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column; 
    overflow: hidden; 
}

.card img {
    width: 100%;
    height: 140px;
    object-fit: contain;
    padding: 10px;
    background: #fcfcfc;
    border-radius: 12px;
}

.product-name {
    margin: 10px 0 5px 0;
    font-size: 16px;
    color: #333;
}

.price{
    color: #0077ff;
    font-size: 18px;
    margin: 15px ;
    font-weight: bold;
    margin-top: auto;
}

.add-to-cart {
    border: none;
    background: #0077ff;
    color: white;
    padding: 10px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 14px;
    width: 100%;
}

.flying-img {
    position: fixed;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    z-index: 9999;
    transition: all 0.8s ease-in-out;
    pointer-events: none; /* لكي لا تعيق النقر */
}

